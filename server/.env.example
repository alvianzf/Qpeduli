ENVIRONMENT=development
PORT=3003

DATABASE_URL=postgresql://user:password@localhost:5432/qpeduli

JWT_SECRET=change-me-to-a-long-random-string

# Seed admin account (only used the first time db/seed.js runs)
ADMIN_EMAIL=admin@qpeduli.com
ADMIN_USERNAME=admin
ADMIN_NAME=Admin Qpeduli
ADMIN_PASSWORD=change-me

# SMTP (transactional email)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Qpeduli" <no-reply@qpeduli.com>
